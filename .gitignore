# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# OS files
.DS_Store
Thumbs.db

# IDE
.vs/
.idea/
*.suo
*.user
*.userprefs

# JetBrains Rider
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# Autogenerated solution/project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx

# Hand-written .NET sources in /src — override the globs above
!/src/**/*.csproj
!/src/*.sln
!/src/*.slnx

# .NET build outputs
/src/**/bin/
/src/**/obj/

# Source-generator emitted files (see Directory.Build.props — kept on disk for inspection only)
/generated/

# Debug/symbol files
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
mono_crash.*

# Build artifacts
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Logs
*.log

# Addressables
/[Ss]erver[Dd]ata/
/[Aa]ssets/[Ss]treamingAssets/aa*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/link.xml*
/[Aa]ssets/[Aa]ddressables_[Tt]emp*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
